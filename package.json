{
  "name": "leagame",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lokales Multiplayer-Partyspiel (Jeopardy x Activity) für einen Geburtstag",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "vite build && node server/index.js",
    "build": "vite build",
    "serve": "node server/index.js",
    "dev": "node --watch-path=server server/index.js --dev",
    "import": "node scripts/import-csv.js",
    "typecheck": "tsc --noEmit -p client"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.2.8",
    "@vitejs/plugin-react": "^6.0.0",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
